# API Gateway Configuration
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here

# Database Configuration
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=auth_db

# JWT Secret (MUST be the same across all services)
JWT_SECRET=your-secret-key-here-change-in-production

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://auth-service:8081
DATASET_SERVICE_URL=http://dataset-service:8082
TRANSACTION_SERVICE_URL=http://transaction-service:8083
ANALYTICS_SERVICE_URL=http://analytics-service:8084
PROVIDER_SERVICE_URL=http://provider-service:8085

# Frontend URL
REACT_APP_BACKEND_URL=http://localhost:8080

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Node Environment
NODE_ENV=production
